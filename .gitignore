# Pi Merchant Framework — Product .gitignore
# -----------------------------------------

# Environment
.env
.env.*
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/
.npm/
.pnpm-debug.log
package-lock.json

# Build output
.next/
.out/
build/
dist/
*.tsbuildinfo

# Coverage
coverage/
lcov.info

# Logs
logs/
*.log

# IDE & OS
.vscode/
.idea/
*.suo
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Temp files
tmp/
temp/
*.tmp
*.swp

# Git hooks
.husky/_

# Turbo cache
.turbo/

# Vercel
.vercel

# Nested repos (standalone git repos, not submodules)
pi-merchant-framework/
assets/
trustwallet-fork/

# Generated documentation and copyright files
scripts/prepare_source_code.py
softcopyright_output/
user_manual_with_images/
screenshots/
archive/
backups/
out/
.scripts/
