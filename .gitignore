# Pi Merchant Framework — .gitignore
# -----------------------------------------

# Environment
.env
.env.*
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/
.npm/
.pnpm-debug.log
package-lock.json

# Build output
.next/
.out/
build/
dist/
*.tsbuildinfo

# Coverage
coverage/
lcov.info

# Logs
logs/
*.log

# IDE & OS
.vscode/
.idea/
*.suo
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Python
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Temp files
tmp/
temp/
*.tmp
*.swp

# Git hooks
.husky/_

# Turbo cache
.turbo/

# Vercel
.vercel

# Generated documentation and copyright artifacts
softcopyright_output/
user_manual_with_images/
screenshots/
archive/
backups/
out/
*.pdf
*.docx
source_code_*
copyright_*.html
user_manual_*.html
mock_screenshots.html
advanced_syntax_fix.py
generate_*.py
