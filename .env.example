# Pi Merchant Framework V2.1.0
# Copy this file to .env and fill in real values before running the app.

# Core
APP_NAME="Pi Merchant Framework"
DATABASE_URL="postgresql://user:password@localhost:5432/pi_merchant_db"
REDIS_URL="redis://localhost:6379"

# App URLs
NEXT_PUBLIC_APP_NAME="Pi Merchant Framework"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_DEFAULT_MERCHANT_ID="merchant-demo-001"
NEXT_PUBLIC_MERCHANT_ID="merchant-demo-001"

# Auth
NEXTAUTH_SECRET="replace_with_strong_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="replace_with_strong_jwt_secret_min_32_chars"
PI_SESSION_SECRET="replace_with_strong_session_secret_in_production"

# Pi Network
PI_API_KEY="your_pi_api_key_here"
PI_PLATFORM_API_BASE="https://api.minepi.com"
PI_SANDBOX=true
DEFAULT_MERCHANT_ID="merchant-demo-001"

# AI routing
AI_PRIMARY_PROVIDER="openai"
AI_FALLBACK_PROVIDERS="anthropic,ollama"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_API_BASE="https://api.anthropic.com"

# Ollama
OLLAMA_ENABLED=true
OLLAMA_API_BASE="http://localhost:11434"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# License
LICENSE_PAYLOAD="base64_encoded_license_json"
LICENSE_PAYLOAD_SECRET="replace_with_strong_license_secret"
LICENSE_PUBLIC_KEY="your_license_public_key"

# Monitoring / webhooks
MONITORING_WEBHOOK_URL="https://example.com/webhook/monitoring"
USAGE_WEBHOOK_URL="https://example.com/webhook/usage"

# Video / generation
RUNWAY_API_KEY="your_runway_api_key"
VIDEO_PROVIDER="runway"
