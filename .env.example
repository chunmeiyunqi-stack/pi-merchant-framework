# ==============================================================
# Pi Merchant Framework V2.1.0 — 环境变量模板
# 复制此文件为 .env，填写真实值后运行项目。
# 切勿将包含真实密钥的 .env 文件提交至版本控制。
# ==============================================================

# ── 数据库 ──────────────────────────────────────────────────
# PostgreSQL 连接字符串（生产环境使用独立实例和强密码）
DATABASE_URL="postgresql://pimerchant:changeme@localhost:5432/pi_merchant_db"

# ── Pi Network ───────────────────────────────────────────────
# 从 Pi Developer Portal 获取的 API Key（后端验证支付必须）
PI_API_KEY="your_pi_api_key_here"
# true = Sandbox 测试网，false = 主网（生产前务必改为 false）
PI_SANDBOX=true
# Pi Platform API 基础地址（通常无需修改）
PI_PLATFORM_API_BASE="https://api.minepi.com"

# ── 应用地址 ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── 认证与安全 ────────────────────────────────────────────────
# NextAuth 密钥：生产环境必须使用随机强密码（openssl rand -base64 32）
NEXTAUTH_SECRET="replace_with_strong_secret_min_32_chars"
NEXTAUTH_URL="http://localhost:3000"
# JWT 内部签名密钥（可与 NEXTAUTH_SECRET 不同，建议独立生成）
JWT_SECRET="replace_with_strong_jwt_secret_min_32_chars"
# Session Token HMAC 密钥（关键！生产必须设置，否则使用不安全的 fallback）
# 生成命令：openssl rand -hex 32
PI_SESSION_SECRET="replace_with_strong_session_secret_in_production"

# ── 许可证与商户 ──────────────────────────────────────────────
# 许可证负载签名密钥（用于颁发和验证 License）
# 生成命令：openssl rand -hex 32
LICENSE_PAYLOAD_SECRET="your_license_payload_secret"
# 当前部署实例的默认商户 ID（对应 merchants 表中的 id 字段）
NEXT_PUBLIC_MERCHANT_ID="merchant-demo-001"
DEFAULT_MERCHANT_ID="merchant-demo-001"

# ── AI 提供商（平台级，所有租户共享此密钥，通过配额隔离）────────
# 主 AI 提供商：openai | anthropic | ollama
AI_PRIMARY_PROVIDER="openai"
# 容错降级顺序（逗号分隔）
AI_FALLBACK_PROVIDERS="anthropic,ollama"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
# 可选：使用自定义 OpenAI 兼容端点（如 Azure OpenAI 或本地代理）
OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic（可选）
# ANTHROPIC_API_KEY="your_anthropic_api_key"

# Ollama 本地推理（可选）
# OLLAMA_API_BASE="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"
# OLLAMA_ENABLED="true"

# ── 视频生成提供商（可选）────────────────────────────────────
# 当前激活的视频提供商：runway | pika | placeholder（默认）
VIDEO_PROVIDER="placeholder"
# Runway ML（需要企业账号）
# RUNWAY_API_KEY="your_runway_api_key"
# Pika Labs（待接入）
# PIKA_API_KEY="your_pika_api_key"

# ── 多租户配额控制 ────────────────────────────────────────────
# 每个租户（merchantId）每月最大 AI 请求次数（0 = 不限制）
AI_MAX_REQUESTS_PER_MONTH=1000
# 每个租户每日最大 AI 请求次数（0 = 不限制）
AI_MAX_REQUESTS_PER_DAY=100

# ── 监控与告警（可选）────────────────────────────────────────
# Prometheus 指标暴露（生产建议限制访问）
# METRICS_ENABLED="true"
# METRICS_SECRET="your_metrics_bearer_token"
# Grafana / 告警 Webhook
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ── 邮件服务（可选，用于通知）────────────────────────────────
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your_smtp_password"
# SMTP_FROM="Pi Merchant <noreply@example.com>"
# 复制此文件为 .env 并填写真实值；此文件仅作示例，切勿提交包含真实秘密的 .env
# ==============================================

# PostgreSQL 连接字符串（开发/生产请分别配置）
DATABASE_URL="postgresql://pimerchant:changeme@localhost:5432/pi_merchant_db"

# Pi Network API Key（从 Pi Developer Portal 获取）
PI_API_KEY="your_pi_api_key_here"

# 是否启用沙盒模式（true=测试网，false=主网）
PI_SANDBOX=true

# 应用地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# NextAuth / JWT
NEXTAUTH_SECRET="replace_this_with_a_32_byte_min_secret"
JWT_SECRET="replace_this_with_a_32_byte_min_secret"

# ------------------------------------------------------------------
# PI_SESSION_SECRET — 强制说明（重要）
# - 在生产环境：必须设置为高熵、随机且安全保管的密钥（例如用
#   `openssl rand -hex 32` 生成）。
# - 切勿在生产中依赖源码中的回退（fallback）值或将回退值推
#   送到远程仓库。
# - 本示例 **不提供** 有效的回退 secret，生产部署前务必设置。
# ------------------------------------------------------------------
PI_SESSION_SECRET="replace_with_strong_session_secret_in_production"

# 可选：默认商户 ID（单租户模式）
DEFAULT_MERCHANT_ID=merchant-demo-001

# 可选：邮件服务
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# ==============================================
# Pi Merchant Framework — 环境变量模板
# 复制此文件为 .env，填写真实值后运行项目
# ==============================================

# ── 数据库 ──────────────────────────────────────
# PostgreSQL 连接字符串（本地开发使用 localhost）
DATABASE_URL="postgresql://user:password@localhost:5432/pi_merchant_db"

# ── Pi Network 配置 ──────────────────────────────
# 从 Pi Developer Portal 获取的 API Key
PI_API_KEY="your_pi_api_key"

# Secret used by the app to sign/verify license payloads and other internal tokens.
# Keep this secret safe and do not commit it. Example: a random 32+ char string.
LICENSE_PAYLOAD_SECRET="your_license_payload_secret"

# 是否启用沙盒模式（true=测试网，false=主网）
PI_SANDBOX=true

# Pi Platform API 基础地址（通常不需要修改）
PI_PLATFORM_API_BASE="https://api.minepi.com"

# ── 应用地址 ─────────────────────────────────────
# 商户前台访问地址（Next.js web app）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 商户后台访问地址（Next.js admin app）
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── 认证配置 ─────────────────────────────────────
# NextAuth.js 密钥（生产环境请使用随机字符串：openssl rand -base64 32）
NEXTAUTH_SECRET="your_nextauth_secret_min_32_chars"

# NextAuth.js 回调地址（与前台地址保持一致）
NEXTAUTH_URL="http://localhost:3000"

# ── 商户配置 ─────────────────────────────────────
# 单租户模式下的默认商户 ID（对应 merchants 表中的 id）
DEFAULT_MERCHANT_ID="your_merchant_id"

# ── 安全 ─────────────────────────────────────────
# JWT 签名密钥（用于内部 API 认证，与 NEXTAUTH_SECRET 可不同）
JWT_SECRET="your_jwt_secret_min_32_chars"

# ── AI 提供商配置 ────────────────────────────────
# 主提供商（openai / anthropic / ollama）
AI_PRIMARY_PROVIDER="openai"

# 容错降级顺序（逗号分隔）
AI_FALLBACK_PROVIDERS="anthropic,ollama"

# OpenAI 配置
OPENAI_API_KEY="your_openai_api_key"
OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic 配置（可选）
# ANTHROPIC_API_KEY="your_anthropic_api_key"
# ANTHROPIC_API_BASE="https://api.anthropic.com"

# Ollama 本地推理（可选）
# OLLAMA_API_BASE="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"
# OLLAMA_ENABLED="true"

# ── 可选：邮件服务（用于通知） ──────────────────
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your_smtp_password"
