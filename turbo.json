{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "PGHOST",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_PASSWORD",
    "PGUSER",
    "NEON_PROJECT_ID",
    "POSTGRES_URL_NO_SSL",
    "PGPASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL",
    "PGHOST_UNPOOLED",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "DATABASE_URL_UNPOOLED",
    "PGDATABASE",
    "PYTHON_SERVICE_URL",
    "NEXT_PUBLIC_PYTHON_SERVICE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "apps/admin/.next/**",
        "!apps/admin/.next/cache/**"
      ],
      "env": [
        "PYTHON_SERVICE_URL",
        "PI_SESSION_SECRET",
        "PI_PLATFORM_API_BASE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_PI_SANDBOX",
        "NEXT_PUBLIC_MERCHANT_ID",
        "NEXT_PUBLIC_PYTHON_SERVICE_URL",
        "PI_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
