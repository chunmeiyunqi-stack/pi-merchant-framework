{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "PI_API_KEY",
        "LICENSE_PAYLOAD_SECRET",
        "OLLAMA_BASE_URL",
        "JWT_SECRET",
        "PI_SESSION_SECRET",
        "NEXT_PUBLIC_MERCHANT_ID",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "PI_PLATFORM_API_BASE",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
