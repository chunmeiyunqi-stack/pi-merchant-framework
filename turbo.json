{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "PI_SESSION_SECRET",
    "NEXTAUTH_SECRET",
    "LICENSE_PAYLOAD_SECRET",
    "PI_API_KEY",
    "PI_VALIDATION_KEY",
    "NEXT_PUBLIC_PI_VALIDATION_KEY",
    "PI_ENVIRONMENT",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "PI_PLATFORM_API_BASE",
    "LICENSE_PAYLOAD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "PI_SESSION_SECRET",
        "NEXTAUTH_SECRET",
        "LICENSE_PAYLOAD_SECRET",
        "PI_API_KEY",
        "PI_VALIDATION_KEY",
        "NEXT_PUBLIC_PI_VALIDATION_KEY",
        "PI_ENVIRONMENT",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "PI_PLATFORM_API_BASE",
        "LICENSE_PAYLOAD"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
