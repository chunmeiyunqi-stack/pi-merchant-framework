 # Python Microservice 环境变量配置
 # 复制此文件为 .env 并填入实际值

 # LongCat API 配置
 LONGCAT_API_KEY=sk-your-api-key-here
 LONGCAT_BASE_URL=https://api.longcat.chat/v1
 LONGCAT_MODEL=LongCat-2.0

 # 服务配置
 SERVICE_HOST=0.0.0.0
 SERVICE_PORT=8000

 # PostgreSQL 数据库配置（可选，用于持久化分析结果）
 DATABASE_URL=postgresql://user:password@localhost:5432/pioneer_quality
