# Allow .env.example to be tracked (template, not credentials)
!.env.example

# ── 环境变量与密钥 ───────────────────────────
.env
.env.local
.env.*.local

# ── Python 虚拟环境 ─────────────────────────
venv/
.venv/
env/

# ── Python 缓存与编译 ────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── IDE & 编辑器 ────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject

# ── 测试与覆盖率 ────────────────────────────
.pytest_cache/
.coverage
*.cover
.hypothesis/
.tox/
htmlcov/

# ── 数据库与日志 ────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log
/logs/

# ── 操作系统 ──────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Docker ──────────────────────────────────
.docker/
*.pid

# ── 杂项 ────────────────────────────────────
.cache/
tmp/
temp/
.python-version
mypy.ini
.mypy_cache/

# Override root .gitignore *.py rule for this directory
!*.py
!app/
!tests/
