{
    "name":  "pi-merchant-framework",
    "version":  "0.1.0",
    "private":  true,
    "description":  "White-label merchant application framework for Pi Network ecosystem",
    "scripts":  {
    "postinstall": "prisma generate",
                    "dev":  "turbo run dev",
                    "build":  "turbo run build",
                    "lint":  "turbo run lint",
                    "type-check":  "turbo run type-check",                    "test": "jest",
                    "test:watch": "jest --watch",
                    "test:coverage": "jest --coverage",                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:push":  "prisma db push",
                    "db:seed":  "tsx prisma/seed.ts",
                    "db:studio":  "prisma studio"
                },
    "devDependencies":  {
                            "turbo":  "^2.0.0",
                            "typescript":  "^5.4.0",
                            "prisma":  "^5.12.0",
                            "@prisma/client":  "^5.12.0",
                            "tsx":  "^4.7.0",
                            "jest": "^29.7.0",
                            "@testing-library/react": "^14.2.1",
                            "@testing-library/jest-dom": "^6.4.2",
                            "@types/jest": "^29.5.12",
                            "ts-jest": "^29.1.2",
                            "jest-environment-jsdom": "^29.7.0"
                        },
    "engines":  {
                    "node":  "\u003e=18.0.0",
                    "pnpm":  "\u003e=8.0.0"
                },
    "packageManager":  "pnpm@8.15.0",
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               }
}
