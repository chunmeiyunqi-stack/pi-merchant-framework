{
  "name": "pi-merchant-framework",
  "version": "2.1.0",
  "private": true,
  "description": "White-label merchant application framework for Pi Network ecosystem",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --ext .ts,.tsx || true",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --coverage --runInBand --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "test:perf:baseline": "docker run --rm -i --network host -v D:/PiMerchantFramework/tests/performance:/scripts grafana/k6 run /scripts/baseline-test.js",
    "test:perf:stress": "docker run --rm -i --network host -v D:/PiMerchantFramework/tests/performance:/scripts grafana/k6 run /scripts/stress-test.js"
  },
  "devDependencies": {
    "@prisma/client": "^5.12.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mock-extended": "^3.0.0",
    "lint-staged": "^17.0.4",
    "node-mocks-http": "^1.14.0",
    "prettier": "^3.8.3",
    "prisma": "^5.12.0",
    "puppeteer": "^25.1.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "docx": "^9.7.1",
    "next-swagger-doc": "^0.4.1",
    "prom-client": "^15.1.3",
    "swagger-ui-react": "^5.32.6"
  }
}
