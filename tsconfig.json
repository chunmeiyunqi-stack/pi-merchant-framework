{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "./apps/web/node_modules/@types"],
    "paths": {
      "@/*": ["./apps/web/src/*", "./apps/admin/src/*", "./src/*"],
      "@pi-merchant/*": ["./packages/*/src"]
    }
  },
  "include": ["apps/**/*", "packages/**/*", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "pi-merchant-framework",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx"
  ]
}
